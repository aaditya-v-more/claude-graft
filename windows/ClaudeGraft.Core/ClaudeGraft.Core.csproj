<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The core is pure BCL — filesystem, process, JSON — so it targets plain
         net10.0 rather than a Windows TFM. That is what lets the test project
         reference it and run under `dotnet test` without the WinUI toolchain,
         even though the junctions it makes only mean anything on Windows. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ClaudeGraft.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>
</Project>
