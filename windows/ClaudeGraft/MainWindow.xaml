<Window x:Class="ClaudeGraft.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Claude Graft">
 <Grid x:Name="RootGrid" Background="{ThemeResource MacWindowBrush}">
  <NavigationView x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="200" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="Navigation_Changed" PaneTitle="Claude Graft" AlwaysShowHeader="True">
   <NavigationView.Header>
    <Grid Margin="4,0,12,0" Height="42"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PageTitle" Text="Claude" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
      <Button x:Name="NewShortcutToolbarButton" Content="New Claude" Click="NewShortcut_Click" ToolTipService.ToolTip="New Claude (Ctrl+N)" AutomationProperties.Name="New Shortcut"/>
      <Button x:Name="HelpButton" Content="Help" AutomationProperties.Name="Help"><Button.Flyout><MenuFlyout>
       <MenuFlyoutItem Text="Using Claude Graft" Click="Website_Click"/>
       <MenuFlyoutItem Text="Source and documentation" Click="Source_Click"/>
       <MenuFlyoutItem Text="Support Claude Graft" Click="Support_Click"/>
      </MenuFlyout></Button.Flyout></Button>
     </StackPanel>
    </Grid>
   </NavigationView.Header>
   <Frame x:Name="RootFrame"/>
  </NavigationView>
 </Grid>
</Window>
