<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ClaudeGraft.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings"
    PrimaryButtonText="Done"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonStyle="{StaticResource DialogPrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource DialogNeutralButtonStyle}">

    <StackPanel Spacing="18" Width="360">
        <StackPanel Spacing="10">
            <TextBlock Text="Appearance" Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Theme" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ThemeBox" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="System" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Backdrop" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="BackdropBox" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Mica" />
                    <ComboBoxItem Content="Mica Alt" />
                    <ComboBoxItem Content="Acrylic" />
                    <ComboBoxItem Content="Solid" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="4">
            <ToggleSwitch x:Name="AutoStartSwitch" Header="Start with Windows" />
            <ToggleSwitch x:Name="StartHiddenSwitch" Header="Start hidden in the notification area" />
        </StackPanel>

        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <TextBlock x:Name="VersionText" Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</ContentDialog>
