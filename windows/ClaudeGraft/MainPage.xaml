<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="ClaudeGraft.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:ClaudeGraft">
 <Page.Resources>
  <Style x:Key="FormField" TargetType="TextBox">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="10,8,0,10"/>
  </Style>
  <Style x:Key="GroupBox" TargetType="Border">
   <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
   <Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14,8"/>
   <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
 </Page.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
   <Grid Padding="10,16,10,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="8">
     <TextBlock Text="Claude" Style="{StaticResource SectionTitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <Button x:Name="MainButton" Click="Main_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Orientation="Horizontal" Spacing="10">
       <FontIcon Glyph="&#xE80F;" FontSize="18"/>
       <StackPanel><TextBlock Text="Claude"/><TextBlock Text="Installed normally" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      </StackPanel>
     </Button>
     <TextBlock Text="Shortcuts" Style="{StaticResource SectionTitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="6">
     <ListView x:Name="ShortcutList" ItemsSource="{x:Bind Shortcuts}" SelectionChanged="Shortcut_SelectionChanged"
       ScrollViewer.HorizontalScrollMode="Disabled" SelectionMode="Single">
      <ListView.ItemTemplate><DataTemplate x:DataType="local:ShortcutRow">
       <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
        <FontIcon Glyph="&#xE71B;" FontSize="18"/>
        <StackPanel MaxWidth="145" AutomationProperties.Name="{x:Bind Name}"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{x:Bind SourceLabel}" FontSize="12" TextTrimming="CharacterEllipsis"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
       </StackPanel>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
     <Button Content="+  New Shortcut" Click="Add_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"/>
    </StackPanel>
    <Grid Grid.Row="2" Padding="0,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <HyperlinkButton NavigateUri="https://ko-fi.com/aadityavmore" Content="♡ Support"
       ToolTipService.ToolTip="Sponsor Claude Graft on Ko-fi. Your support keeps this free app worked on." AutomationProperties.Name="Support Claude Graft on Ko-fi"/>
     <HyperlinkButton Grid.Column="1" NavigateUri="https://github.com/aaditya-v-more/claude-graft" Content="&lt;/&gt; Source"
       ToolTipService.ToolTip="View the source on GitHub"/>
    </Grid>
   </Grid>
  </Border>
  <Grid Grid.Column="1" x:Name="DetailPanel">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Padding="22,10,16,4">
    <TextBlock x:Name="DetailTitle" Text="Claude Graft" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
     <Button Content="↻" Click="Refresh_Click" ToolTipService.ToolTip="Refresh usage" AutomationProperties.Name="Refresh usage"/>
     <Button Content="⚙" Click="Settings_Click" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings"/>
    </StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
    <StackPanel Spacing="18" Padding="22,14,22,20">
     <InfoBar x:Name="Problem" IsOpen="False" IsClosable="True" Severity="Error"/>
     <StackPanel>
      <TextBlock x:Name="ShortcutHeader" Text="Shortcut" Style="{StaticResource SectionTitle}"/>
      <Border Style="{StaticResource GroupBox}"><StackPanel>
       <Grid MinHeight="44" ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Name" VerticalAlignment="Center"/>
        <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource FormField}" TextAlignment="Right" TextChanged="Name_Changed" AutomationProperties.Name="Shortcut name"/>
       </Grid>
       <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
       <Grid MinHeight="44" ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Profile folder" VerticalAlignment="Center"/>
        <TextBox x:Name="FolderBox" Grid.Column="1" Style="{StaticResource FormField}" TextAlignment="Right" FontFamily="Consolas" AutomationProperties.Name="Profile folder"/>
        <Button Grid.Column="2" Content="▱" Click="Folder_Click" ToolTipService.ToolTip="Show in File Explorer" AutomationProperties.Name="Show profile folder"/>
       </Grid>
       <StackPanel x:Name="IconSection" Margin="0,8,0,4" Spacing="8">
        <TextBlock Text="Shortcut icon" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <ComboBox x:Name="IconBox" ItemsSource="{x:Bind IconPresets}" HorizontalAlignment="Stretch" AutomationProperties.Name="Shortcut icon">
         <ComboBox.ItemTemplate><DataTemplate x:DataType="local:IconChoice"><StackPanel Orientation="Horizontal" Spacing="10">
          <Image Source="{x:Bind Preview}" Width="24" Height="24"/><TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"/>
         </StackPanel></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
       </StackPanel>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="ChatsSection">
      <TextBlock Text="Chats" Style="{StaticResource SectionTitle}"/>
      <Border Style="{StaticResource GroupBox}"><StackPanel Spacing="10">
       <Grid ColumnSpacing="16" MinHeight="42">
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Reads chats from" VerticalAlignment="Center"/>
        <ComboBox x:Name="SourceBox" Grid.Column="1" DisplayMemberPath="Label" HorizontalAlignment="Stretch"
          SelectionChanged="Source_Changed" AutomationProperties.Name="Reads chats from"/>
       </Grid>
       <TextBlock x:Name="MergeNote" Text="Both profiles keep their own chats and gain the source's. Copies made into the source stay there; merging histories cannot be undone."
         TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel>
      <TextBlock Text="Status" Style="{StaticResource SectionTitle}"/>
      <Border Style="{StaticResource GroupBox}"><StackPanel Spacing="10" Padding="0,8">
       <Grid x:Name="ShortcutStatusRow" ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Shortcut"/><TextBlock x:Name="ShortcutStatus" Grid.Column="1" TextAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       </Grid>
       <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Claude"/><TextBlock Text="{Binding StatusLabel}" Grid.Column="1" TextAlignment="Right" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       </Grid>
       <Button x:Name="SignInButton" Content="Complete browser sign-in…" Click="SignIn_Click" HorizontalAlignment="Right"
        ToolTipService.ToolTip="Send a browser sign-in link to this profile if Windows opened it in the main Claude."/>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel>
      <TextBlock Text="Plan usage" Style="{StaticResource SectionTitle}"/>
      <Border Style="{StaticResource GroupBox}"><StackPanel Padding="0,8" Spacing="10">
       <StackPanel Spacing="6" Visibility="{Binding BarsVisibility}">
        <TextBlock Text="{Binding FiveHourText}" FontSize="12"/><ProgressBar Value="{Binding FiveHour}" Maximum="100" Foreground="#34C759"/>
        <TextBlock Text="{Binding WeekText}" FontSize="12" Margin="0,8,0,0"/><ProgressBar Value="{Binding Week}" Maximum="100" Foreground="#34C759"/>
        <TextBlock Text="{Binding FableText}" Visibility="{Binding FableVisibility}" FontSize="12" Margin="0,8,0,0"/>
        <ProgressBar Value="{Binding Fable}" Visibility="{Binding FableVisibility}" Maximum="100" Foreground="#34C759"/>
       </StackPanel>
       <TextBlock Text="No usage reported yet" Visibility="{Binding NoUsageVisibility}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <TextBlock Text="{Binding Problem}" Visibility="{Binding ProblemVisibility}" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel></Border>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" Padding="14" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="DeleteButton" Content="Delete Shortcut…" Click="Delete_Click"/>
    <Button Grid.Column="2" x:Name="StartButton" Content="Start Session" Click="Start_Click" IsEnabled="{Binding StartEnabled}" ToolTipService.ToolTip="{Binding StartTooltip}"/>
    <Button Grid.Column="3" x:Name="OpenButton" Content="Open" Click="Open_Click"/>
    <Button Grid.Column="4" x:Name="SaveButton" Content="Update Shortcut" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"/>
   </Grid>
  </Grid>
 </Grid>
</Page>
