<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ClaudeGraft.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,10" ColumnSpacing="8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xEA86;" FontSize="16" Foreground="{StaticResource GraftTextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="Mods" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <Button Style="{StaticResource InfoGlyphButton}" Grid.Column="2"
                    AutomationProperties.Name="About Mods" AutomationProperties.AutomationId="mods.info"
                    ToolTipService.ToolTip="About Mods">
                <FontIcon Glyph="&#xE946;" FontSize="14" />
                <Button.Flyout>
                    <Flyout>
                        <TextBlock x:Name="NoteText" MaxWidth="360" TextWrapping="Wrap" />
                    </Flyout>
                </Button.Flyout>
            </Button>
            <SelectorBar Grid.Column="3" x:Name="Views" SelectionChanged="Views_Changed" Margin="8,0,0,0"
                         AutomationProperties.Name="Mods view" AutomationProperties.AutomationId="mods.views">
                <SelectorBarItem Text="Installed" IsSelected="True"
                                 AutomationProperties.Name="Installed mods" AutomationProperties.AutomationId="mods.views.installed" />
                <SelectorBarItem x:Name="FeaturedItem" Text="Featured"
                                 AutomationProperties.Name="Featured mods" AutomationProperties.AutomationId="mods.views.featured" />
                <SelectorBarItem x:Name="BrowseItem" Text="Browse"
                                 AutomationProperties.Name="Browse every mod" AutomationProperties.AutomationId="mods.views.browse" />
            </SelectorBar>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                <Button Click="AddMod_Click"
                        AutomationProperties.AutomationId="mods.add" AutomationProperties.Name="Add Mod"
                        ToolTipService.ToolTip="Choose a mod's folder to copy into Graft">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Add Mod…" />
                    </StackPanel>
                </Button>
                <Button Click="OpenFolder_Click" Padding="8" Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.AutomationId="mods.openFolder" AutomationProperties.Name="Open Mods Folder"
                        ToolTipService.ToolTip="Open the folder Graft keeps its mods in">
                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                </Button>
            </StackPanel>
            <Button Grid.Column="5" Click="Refresh_Click" Padding="8" Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Read the mods again"
                    AutomationProperties.Name="Refresh Mods" AutomationProperties.AutomationId="mods.refresh">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" x:Name="FilterBar" Visibility="Collapsed" Margin="16,12,16,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Search mods" TextChanged="Filter_Changed"
                     AutomationProperties.Name="Search mods by name, description or repository" AutomationProperties.AutomationId="mods.browse.search" ToolTipService.ToolTip="Search by name, description or repository" />
            <ComboBox Grid.Column="1" x:Name="ReachBox" SelectedIndex="0" SelectionChanged="Filter_Changed" Width="160"
                      AutomationProperties.Name="Most a mod may reach" AutomationProperties.AutomationId="mods.browse.reach"
                      ToolTipService.ToolTip="The most a mod may reach, by the list's scan">
                <ComboBoxItem Content="Any access" />
                <ComboBoxItem Content="Draws only" />
                <ComboBoxItem Content="Up to reading" />
                <ComboBoxItem Content="No network" />
            </ComboBox>
            <CheckBox Grid.Column="2" x:Name="PassedBox" Content="Validates" MinWidth="0" Click="Filter_Changed"
                      AutomationProperties.Name="Only mods that pass validation" AutomationProperties.AutomationId="mods.browse.passed"
                      ToolTipService.ToolTip="Only mods Claude Code's validator passed in the scan" />
            <CheckBox Grid.Column="3" x:Name="DesktopBox" Content="Mentions Desktop" IsChecked="True" MinWidth="0" Click="Filter_Changed"
                      AutomationProperties.Name="Only mods whose description mentions Claude Desktop" AutomationProperties.AutomationId="mods.browse.desktop"
                      ToolTipService.ToolTip="Only mods whose author says they work in the desktop app; nothing in their code is checked" />
            <ComboBox Grid.Column="4" x:Name="SortBox" SelectedIndex="0" SelectionChanged="Filter_Changed" Width="170"
                      AutomationProperties.Name="Sort mods" AutomationProperties.AutomationId="mods.browse.sort">
                <ComboBoxItem Content="Most stars" />
                <ComboBoxItem Content="Recently updated" />
                <ComboBoxItem Content="Name" />
            </ComboBox>
        </Grid>
        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="Rows" Padding="16,12" Spacing="10" />
        </ScrollViewer>
    </Grid>
</Page>
