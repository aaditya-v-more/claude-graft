<SolidColorBrush x:Key="MacGroupBrush" Color="#2B2F30"/>
<SolidColorBrush x:Key="MacTextBrush" Color="#E8E9E9"/>
<SolidColorBrush x:Key="MacSecondaryBrush" Color="#9FA3A4"/>
