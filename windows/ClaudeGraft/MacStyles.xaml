<SolidColorBrush x:Key="MacHoverBrush" Color="#18FFFFFF"/>
<SolidColorBrush x:Key="MacAccentBrush" Color="#0A84FF"/>
<SolidColorBrush x:Key="MacSelectionBrush" Color="#075FD5"/>
<SolidColorBrush x:Key="MacTrackBrush" Color="#484D4E"/>
<SolidColorBrush x:Key="MacFrameBrush" Color="#555B5C"/>
<SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E8E9E9"/>
<SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9FA3A4"/>
<SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#717677"/>
<SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#3D4243"/>
<SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#2B2F30"/>
<SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#484D4E"/>
<SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0A84FF"/>
<SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
<SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#18FFFFFF"/>
<SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
<SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
<SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent"/>
<SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#18FFFFFF"/>
<SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent"/>
<SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2B2F30"/>
<SolidColorBrush x:Key="ContentDialogBackground" Color="#242829"/>
<SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#25000000"/>
<Color x:Key="SystemAccentColor">#0A84FF</Color>
</ResourceDictionary>
<ResourceDictionary x:Key="Light">
<SolidColorBrush x:Key="MacWindowBrush" Color="#F5F5F5"/>
<SolidColorBrush x:Key="MacSidebarBrush" Color="#ECECEE"/>
<SolidColorBrush x:Key="MacGroupBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="MacTextBrush" Color="#242426"/>
<SolidColorBrush x:Key="MacSecondaryBrush" Color="#77777C"/>
<SolidColorBrush x:Key="MacTertiaryBrush" Color="#99999E"/>
<SolidColorBrush x:Key="MacDividerBrush" Color="#E6E6E7"/>
<SolidColorBrush x:Key="MacButtonBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="MacButtonBorderBrush" Color="#D0D0D2"/>
<SolidColorBrush x:Key="MacHoverBrush" Color="#0A000000"/>
<SolidColorBrush x:Key="MacAccentBrush" Color="#007AFF"/>
<SolidColorBrush x:Key="MacSelectionBrush" Color="#0065DC"/>
<SolidColorBrush x:Key="MacTrackBrush" Color="#DCDCDD"/>
<SolidColorBrush x:Key="MacFrameBrush" Color="#B7B7BA"/>
<SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#242426"/>
<SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#77777C"/>
<SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#99999E"/>
<SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFFFFF"/>
<SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#DCDCDD"/>
<SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#007AFF"/>
<SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
<SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0A000000"/>
<SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
<SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
<SolidColorBrush x:Key="ComboBoxBackground" Color="Transparent"/>
