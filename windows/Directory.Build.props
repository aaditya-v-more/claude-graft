<Project>
  <!--
    The repository's VERSION is the one place the number is written down, for
    the Mac and Windows alike: a release is one version on both, published as
    one GitHub release. Stamped into every assembly so Assembly.GetName().Version
    is the truth, which an update check comparing the running build against the
    latest release cannot work without. The release workflow overrides
    GraftVersion from the tag, so the binary and the release it came from agree.
  -->
  <PropertyGroup>
    <!-- Only the release workflow passes GraftVersion, so a build that reads VERSION is a development one. -->
    <GraftVersionSuffix Condition="'$(GraftVersion)' == ''">-dev</GraftVersionSuffix>
    <GraftVersionRaw Condition="'$(GraftVersion)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../VERSION'))</GraftVersionRaw>
    <GraftVersion Condition="'$(GraftVersion)' == ''">$(GraftVersionRaw.Trim())</GraftVersion>
    <Version>$(GraftVersion)</Version>
    <AssemblyVersion>$(GraftVersion)</AssemblyVersion>
    <FileVersion>$(GraftVersion)</FileVersion>
    <InformationalVersion>$(GraftVersion)$(GraftVersionSuffix)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
