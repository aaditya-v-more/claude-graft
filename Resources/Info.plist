<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>Claude Graft</string>
    <key>CFBundleDisplayName</key><string>Claude Graft</string>
    <key>CFBundleIdentifier</key><string>graft.claude-graft</string>
    <key>CFBundleExecutable</key><string>ClaudeGraft</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <!-- Both stamped by build.sh from the VERSION file at the repo root, which
         is the only place the number is written down. 0.0.0 here is a
         placeholder: a bundle still carrying it was never stamped. -->
    <key>CFBundleShortVersionString</key><string>0.0.0</string>
    <key>CFBundleVersion</key><string>0.0.0</string>
    <key>LSMinimumSystemVersion</key><string>13.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSSupportsAutomaticTermination</key><true/>
    <!-- Sparkle. The feed is a GitHub Pages path and is baked into every copy
         ever shipped: a build that is out in the world polls the URL it was born
         with, and GitHub gives Pages no redirect if the account is ever renamed.
         SUPublicEDKey is the public half of the key in the login keychain; an
         update whose signature does not match it is refused. -->
    <key>SUFeedURL</key><string>https://aaditya-v-more.github.io/claude-graft/appcast.xml</string>
    <key>SUPublicEDKey</key><string>TncOVOd5VFXtXoAD5/KoGC2ea9ls2tO3amPVx5jtty8=</string>
    <key>SUEnableAutomaticChecks</key><true/>
</dict>
</plist>
